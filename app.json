{
  "addons": ["heroku-postgresql:hobby-dev"],
  "buildpacks": [
    {
      "url": "https://github.com/HashNuke/heroku-buildpack-elixir"
    },
    {
      "url": "https://github.com/gjaldon/heroku-buildpack-phoenix-static"
    }
  ],
  "env": {
    "HEROKU_APP_NAME": {
      "required": true
    },
    "POOL_SIZE": {
      "value": "18"
    },
    "SECRET_KEY_BASE": {
      "generator": "secret"
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "free"
    }
  },
  "scripts": {
    "postdeploy": "POOL_SIZE=2 mix ecto.migrate && POOL_SIZE=2 mix run priv/repo/seeds.exs"
  }
}
