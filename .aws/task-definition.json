{
  "family": "currency_watch_staging",
  "taskRoleArn": "arn:aws:iam::833583610700:role/ecs_task",
  "containerDefinitions": [
    {
      "name": "currency_watch_staging",
      "image": "833583610700.dkr.ecr.eu-central-1.amazonaws.com/currency_watch",
      "memoryReservation": 400,
      "portMappings": [
        {
          "containerPort": 4000,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "secrets": [
        {
          "name": "CURRENCY_LAYER_KEY",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:833583610700:secret:currency_watch/staging-MZio6K/CURRENCY_LAYER_KEY"
        },
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:833583610700:secret:currency_watch/staging-MZio6K/DATABASE_URL"
        },
        {
          "name": "HOST",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:833583610700:secret:currency_watch/staging-MZio6K/HOST"
        },
        {
          "name": "SECRET_KEY_BASE",
          "valueFrom": "arn:aws:secretsmanager:eu-central-1:833583610700:secret:currency_watch/staging-MZio6K/SECRET_KEY_BASE"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/currency_watch_staging",
          "awslogs-region": "eu-central-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "curl -f http://localhost/ || exit 1"
        ]
      }
    }
  ],
  "requiresCompatibilities": ["EC2"],
  "memory": "400"
}
